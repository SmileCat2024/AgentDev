{
  "name": "@agentdev/viewer",
  "version": "0.1.0",
  "description": "AgentDev debugger viewer: ViewerWorker HTTP/UDS host, web UI, read-only debugger MCP",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "agentdev-viewer": "dist/cli/viewer.js",
    "agentdev-server": "dist/cli/server.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@agentdev/core": "^0.1.0",
    "@modelcontextprotocol/node": "^2.0.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "open": "^11.0.0",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.0.0",
    "@types/node": "^20.11.0",
    "tsup": "^8.3.5",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "agentdev",
    "debugger",
    "viewer",
    "mcp"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/your-org/agentdev.git"
  },
  "license": "MIT"
}
