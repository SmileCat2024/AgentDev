{
  "name": "@agentdevjs/qqbot-feature",
  "version": "0.1.0",
  "description": "QQ Bot feature for AgentDev - enables QQ bot integration",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "@agentdevjs/core": "^0.1.0"
  },
  "dependencies": {
    "mpg123-decoder": "^1.0.3",
    "silk-wasm": "^3.7.1",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "typescript": "^5.3.3",
    "tsup": "^8.3.5",
    "@agentdevjs/core": "file:../core"
  },
  "tsup": {
    "entry": [
      "src/index.ts"
    ],
    "format": "esm",
    "splitting": false,
    "dts": true,
    "clean": true,
    "sourcemap": true
  },
  "keywords": [
    "agentdev",
    "feature",
    "qqbot"
  ],
  "license": "MIT"
}
