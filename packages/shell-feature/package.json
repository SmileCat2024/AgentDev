{
  "name": "@agentdev/shell-feature",
  "version": "0.3.0",
  "description": "Shell execution feature for AgentDev - provides bash execution and safe trash operations",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build"
  },
  "tsup": {
    "entry": [
      "src/index.ts",
      "src/templates/*.render.ts"
    ],
    "format": "esm",
    "dts": true,
    "clean": true,
    "sourcemap": true
  },
  "peerDependencies": {
    "@agentdev/core": "^0.3.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "tsup": "^8.3.5",
    "typescript": "^5.3.3",
    "vitest": "^4.1.10",
    "@agentdev/core": "file:../core"
  },
  "keywords": [
    "agentdev",
    "feature",
    "shell",
    "bash",
    "trash"
  ],
  "license": "MIT"
}
