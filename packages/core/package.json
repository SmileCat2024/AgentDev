{
  "name": "@agentdev/core",
  "version": "0.1.0",
  "description": "AgentDev core runtime: Agent / Context / Feature system / continuity / WorkThread / logging / template / skills",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "diff": "^8.0.3",
    "glob": "^13.0.6",
    "js-yaml": "^4.1.0",
    "vscode-jsonrpc": "^8.2.1",
    "vscode-languageserver-types": "^3.18.0"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.11.0",
    "tsup": "^8.3.5",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "agentdev",
    "agent",
    "llm",
    "framework"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/your-org/agentdev.git"
  },
  "license": "MIT"
}
