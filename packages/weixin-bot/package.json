{
  "name": "@agentdevjs/weixin-bot",
  "version": "0.1.0",
  "description": "weixin-bot feature for AgentDev",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "agentdev-feature.json"
  ],
  "scripts": {
    "build": "tsup && npm run copy-assets",
    "dev": "tsup --watch",
    "copy-assets": "node scripts/copy-assets.mjs",
    "prepublishOnly": "npm run build"
  },
  "tsup": {
    "entry": [
      "src/index.ts"
    ],
    "format": "esm",
    "dts": true,
    "clean": true,
    "sourcemap": true
  },
  "peerDependencies": {
    "@agentdevjs/core": "^0.1.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "tsup": "^8.3.5",
    "typescript": "^5.3.3",
    "@agentdevjs/core": "file:../core"
  },
  "keywords": [
    "agentdev",
    "feature",
    "weixin-bot"
  ],
  "license": "MIT",
  "dependencies": {
    "@types/qrcode": "^1.5.6",
    "open": "^11.0.0",
    "qrcode": "^1.5.4"
  }
}
