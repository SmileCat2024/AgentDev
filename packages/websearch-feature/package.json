{
  "name": "@agentdevjs/websearch-feature",
  "version": "0.1.0",
  "description": "Web search and content fetching feature for AgentDev",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup && npm run copy-assets",
    "dev": "tsup --watch",
    "copy-assets": "node scripts/copy-assets.mjs",
    "prepublishOnly": "npm run build"
  },
  "tsup": {
    "entry": [
      "src/index.ts",
      "src/templates/*.render.ts"
    ],
    "format": "esm",
    "dts": true,
    "clean": true,
    "sourcemap": true
  },
  "peerDependencies": {
    "@agentdevjs/core": "^0.1.0",
    "@agentdevjs/mcp": "^0.1.0"
  },
  "dependencies": {
    "js-yaml": "^4.1.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/js-yaml": "^4.0.5",
    "tsup": "^8.3.5",
    "typescript": "^5.3.3",
    "@agentdevjs/core": "file:../core",
    "@agentdevjs/mcp": "file:../mcp"
  },
  "keywords": [
    "agentdev",
    "feature",
    "web",
    "search",
    "fetch",
    "crawl"
  ],
  "license": "MIT"
}
