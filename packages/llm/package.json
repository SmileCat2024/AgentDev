{
  "name": "@agentdev/llm",
  "version": "0.1.0",
  "description": "AgentDev LLM adapters: AnthropicLLM / OpenAILLM / OpenAIResponsesLLM / createLLM / message compilation",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@agentdev/core": "^0.1.0",
    "openai": "^4.73.0",
    "undici": "^7.25.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "tsup": "^8.3.5",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "agentdev",
    "llm",
    "anthropic",
    "openai"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/your-org/agentdev.git"
  },
  "license": "MIT"
}
