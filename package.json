{
  "name": "agentdev",
  "version": "0.3.0",
  "description": "AgentDev monorepo (npm package `agentdev` is retired; use @agentdev/core, @agentdev/llm, @agentdev/viewer, @agentdev/mcp and @agentdev/feature-*)",
  "type": "module",
  "private": true,
  "workspaces": [
    "packages/*",
    "!packages/qqbot-feature"
  ],
  "scripts": {
    "build": "node scripts/build-all.mjs",
    "dev": "npm run dev -w @agentdev/core",
    "test": "npm test --workspaces --if-present",
    "test:ci": "npm test --workspaces --if-present",
    "lint": "eslint packages/core/src packages/llm/src packages/viewer/src packages/mcp/src",
    "lint:fix": "eslint packages/core/src packages/llm/src packages/viewer/src packages/mcp/src --fix",
    "typecheck": "npm run typecheck -w @agentdev/core && npm run typecheck -w @agentdev/llm -w @agentdev/viewer -w @agentdev/mcp",
    "check:versions": "node scripts/check-versions.mjs",
    "check:core-deps": "node scripts/assert-core-deps.mjs",
    "build-and-pack-features": "node scripts/build-and-pack-features.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^20.11.0",
    "@vitest/coverage-v8": "^4.1.10",
    "@vitest/ui": "^4.1.10",
    "eslint": "^10.6.0",
    "globals": "^17.7.0",
    "tsup": "^8.3.5",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3",
    "typescript-eslint": "^8.63.0",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "license": "MIT"
}
