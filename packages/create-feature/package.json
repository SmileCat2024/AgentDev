{
  "name": "@agentdevjs/create-feature",
  "version": "0.1.0",
  "description": "CLI tool to create AgentDev Feature packages",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./cli": "./dist/cli.js"
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build"
  },
  "tsup": {
    "entry": ["src/index.ts", "src/cli.ts"],
    "format": "esm",
    "splitting": false,
    "dts": true,
    "clean": true,
    "sourcemap": true
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "tsup": "^8.3.5",
    "typescript": "^5.3.3",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "prompts": "^2.4.2",
    "minimist": "^1.2.8"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "agentdev",
    "feature",
    "cli",
    "scaffold"
  ],
  "license": "MIT"
}
